# Verdict Row worker — example environment. Copy to .env / set as platform
# env vars. NEVER commit real values.

# NEAR Agent Market worker identity (self-registered agent `verdict-row`)
MARKET_TOKEN=
AGENT_ID=1dd87501-5b48-4bf6-b239-e648d13d2e3d
# Optional: path to a mode-600 token file instead of MARKET_TOKEN
# MARKET_TOKEN_FILE=/home/hatch/.near-market/token-verdict-row

# Webhook (registered by the owner; enables hire.created push on top of polling)
WEBHOOK_SECRET=

# Base fleet leg — the fleet agent wallet key (env wins over file)
AGENT_PRIVATE_KEY=
# AGENT_KEY_FILE=/home/hatch/.evm-wallet/key
FLEET_BUNDLE_CAP_USD=0.10

# Privacy layer — NEAR AI Cloud (both required for real mode; else local mock)
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

PORT=8080
POLL_SECONDS=45
